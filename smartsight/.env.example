# SmartSight configuration
#
# Copy to `.env` in this folder (smartsight/.env) for the backend.
# Copy the frontend value into `frontend/.env.local` for the Next.js app.

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
APP_NAME=SmartSight

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where SmartSight keeps SQLite, recordings, thumbnails, snapshots and Chroma.
# Defaults to backend/data when unset.
# DATA_DIR=D:/SmartSight/data

# Vision models (CPU by default). Set CLIP_DEVICE=cuda on an NVIDIA machine.
# DETECTOR_MODEL=D:/SmartSight/backend/yolov8n.pt
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion400m_e32
CLIP_DEVICE=cpu
# 0 = auto (half the logical cores, capped at 4)
TORCH_THREADS=0

# Default camera source. Replace with your ESP32-CAM URL in the UI or here.
STREAM_URL_DEFAULT=sim://demo
LIVE_FPS_DEFAULT=2
LIVE_INDEX_INTERVAL_DEFAULT=3

# Uploaded video indexing
SAMPLE_FPS_DEFAULT=2
VIDEO_UPLOAD_MAX_MB=2048
VIDEO_INDEX_MAX_FRAMES=6000
THUMBNAIL_MAX_WIDTH=720

# ---------------------------------------------------------------------------
# Frontend (Next.js) → put this in frontend/.env.local
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
