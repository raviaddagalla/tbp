# ==========================================================================
# Factory Intelligence Platform — environment template
# Copy to `.env` and edit. All variables are optional (sane defaults exist).
# ==========================================================================

# --- App ----------------------------------------------------------------
# APP_NAME=Factory Intelligence Platform
# ENVIRONMENT=dev            # production refuses to boot with the dev SECRET_KEY
# SECRET_KEY=change-me       # MUST be a strong random value in any shared deployment
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database ------------------------------------------------------------
# Default: SQLite at ./data/factory.db (single machine).
# Two-laptop shared deployment: use the SAME Neon (Postgres) URL on both.
#   DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# The first boot seeds users + cameras once; the other laptop reads the same data.

# --- Vector store --------------------------------------------------------
# auto  -> pgvector when DATABASE_URL is Postgres, otherwise Chroma/NumPy fallback
# VECTOR_STORE_BACKEND=auto

# --- Remote media (Cloudflare R2, S3-compatible) -------------------------
# When enabled, thumbnails / uploaded videos / clips are mirrored to the
# bucket so BOTH laptops see the same media. Local disk acts as a cache.
# Both laptops must use the same bucket + credentials.
# MEDIA_REMOTE_ENABLED=true
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_BUCKET=factory-intel-media
# R2_REGION=auto

# --- Worker mode ----------------------------------------------------------
# true = this machine processes camera frames / clips.
# Set WORKER_ENABLED=false on a second laptop that only browses/shows the
# dashboard, so the same cameras are not processed twice.
# WORKER_ENABLED=true

# --- LLM (chat / summaries) ----------------------------------------------
# LLM_PROVIDER=mock          # groq for real answers (free tier works)
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# --- Tuning --------------------------------------------------------------
# CLIP_INFERENCE_THREADS=4
# FRAME_SAMPLE_INTERVAL_DEFAULT=0.2
# VIDEO_UPLOAD_MAX_MB=2048
# DETECTOR_MODEL=yolov8n
# ANOMALY_ENABLED_DEFAULT=false
# SEED_DEMO_SIM_CAMERAS=false
