# ============================================================
# Factory Intelligence Platform - Environment Configuration
# Copy to `.env` and fill in your values. NEVER commit `.env`.
# ============================================================

# --- App ---
APP_NAME=Factory Intelligence Platform
# dev | production — production REFUSES to boot with the dev default SECRET_KEY
ENVIRONMENT=dev
# CHANGE THIS in any shared/deployed environment (dev default only)
SECRET_KEY=dev-secret-key-change-me-please-use-a-stronger-one
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Storage ---
DATABASE_URL=sqlite:///./data/factory.db
DATA_DIR=./data

# --- Vector store ---
# chroma (default, persistent local) | numpy (zero-dependency fallback)
VECTOR_STORE_BACKEND=chroma
CHROMA_DIR=./data/vectorstore

# --- CLIP embedding model ---
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion400m_e32
# auto | cpu | cuda (auto picks CUDA if available, else CPU)
CLIP_DEVICE=auto
CLIP_INFERENCE_THREADS=4

# --- Camera ingestion defaults (per-camera overrides in the UI) ---
# 0.2s = 5 frames analysed per second (default for live cameras + uploads)
FRAME_SAMPLE_INTERVAL_DEFAULT=0.2
CLIP_SEGMENT_SECONDS_DEFAULT=30
RETENTION_HOURS_DEFAULT=72
PREVIEW_FPS=2

# --- Video file upload (CCTV footage, MP4/MOV/AVI/MKV/WebM) ---
VIDEO_UPLOAD_MAX_MB=2048

# --- LLM (RAG chat, summaries, incident reports) ---
# Provider: groq | openai | anthropic | mock
#   groq      -> LLM_API_KEY + LLM_BASE_URL=https://api.groq.com/openai/v1 + LLM_MODEL
#   openai    -> OpenAI key
#   anthropic -> Anthropic key
#   mock      -> fully offline, answers from retrieved context only (no key needed)
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2

# --- OCR (optional; Tesseract binary path if installed) ---
# e.g. C:\\Program Files\\Tesseract-OCR\\tesseract.exe on Windows
TESSERACT_CMD=

# --- Safety anomaly detection (stretch) ---
ANOMALY_ENABLED_DEFAULT=0
ANOMALY_THRESHOLD=0.22
ANOMALY_COOLDOWN_SECONDS=120
ANOMALY_CHECK_INTERVAL_SECONDS=15

# --- Edge-aware processing (stretch): auto-throttle under load ---
EDGE_ADAPTIVE_LOAD=1

# --- Auth (httpOnly cookie sessions + scoped media tokens) ---
# Slowapi limit for the login endpoint, e.g. 10/minute
LOGIN_RATE_LIMIT=10/minute
# Media tokens are scoped to a single stream URL and expire quickly
MEDIA_TOKEN_TTL_MINUTES=5

# --- Vector store limits & maintenance ---
# Hard cap for the NumPy fallback store (raises instead of growing unbounded)
NUMPY_STORE_MAX_VECTORS=50000
# Hour (UTC) of the nightly Chroma compaction job
COMPACTION_HOUR_UTC=3

# --- Object detection / tracking (Phase 1) ---
DETECTOR_ENABLED_DEFAULT=1
DETECTOR_MODEL=yolov8n
DETECTOR_CONFIDENCE_THRESHOLD=0.35
TRACKER_ENABLED_DEFAULT=1
ATTRIBUTES_ENABLED_DEFAULT=1

# --- Cross-camera ReID & tracklet stitching (Phase 2) ---
REID_ENABLED_DEFAULT=1
REID_COLLECTION=factory_intel_reid
# OSNet checkpoint: osnet_x1_0_msmt17 (auto-downloaded from HuggingFace
# kaiyangzhou/osnet to <DATA_DIR>/reid) | none | disabled
REID_MODEL=osnet_x1_0_msmt17
# Local .pth override; empty = auto-download
REID_WEIGHTS_PATH=
# α,β,γ weights: reid_similarity, time_fit, adjacency
STITCH_WEIGHTS=1.0,1.0,1.0

# --- Batch reprocessing of recorded footage (Phase 3) ---
BATCH_REPROCESS_ENABLED_DEFAULT=1
BATCH_REPROCESS_AFTER_HOURS=24
BATCH_REPROCESS_WINDOW_SECONDS=16
BATCH_REPROCESS_STRIDE=8

# --- Signed update packages (Phase 4) ---
UPDATE_PUBLIC_KEY_PATH=
